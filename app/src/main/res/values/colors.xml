<?xml version="1.0" encoding="utf-8"?>
<!--
	What colors look good together: https://www.canva.com/colors/color-wheel/
-->
<resources>
	<!--*******************************************
		Keyboard
	*******************************************-->

	<color name="keyboard_background">#e8eaed</color>
	<color name="keyboard_text">#3d3d3f</color>
	<color name="keyboard_top_separator">@color/key_fn_background</color>
	<color name="keyboard_wrapper_background">@android:color/transparent</color>
	<color name="keyboard_wrapper_top_separator">@android:color/transparent</color>

	<color name="key_num_background">#fff</color>
	<color name="key_num_border">@android:color/transparent</color>
	<color name="key_num_ripple">#eff0f1</color>
	<color name="key_num_text">#333</color>
	<color name="key_num_alternative_text">#4d4d4f</color> <!-- 'hold' functions -->

	<color name="key_fn_background">#ccced5</color>
	<color name="key_fn_border">@android:color/transparent</color>
	<color name="key_fn_ripple">#b9bbc2</color>
	<color name="key_fn_text">@color/keyboard_text</color>
	<color name="key_fn_alternative_text">#4e4e50</color> <!-- 'hold' functions -->

	<color name="key_lf4_background">@color/key_fn_background</color>
	<color name="key_lf4_border">@android:color/transparent</color>
	<color name="key_lf4_ripple">@color/key_fn_ripple</color>
	<color name="key_lf4_text">@color/key_fn_text</color>
	<color name="key_lf4_alternative_text">@color/key_fn_alternative_text</color> <!-- 'hold' functions -->

	<color name="key_ok_background">#1a73e8</color>
	<color name="key_ok_border">@android:color/transparent</color>
	<color name="key_ok_ripple">#0961d6</color>
	<color name="key_ok_text">#fff</color>

	<color name="suggestion_selected_background">#8cb7f9</color> <!-- 8ed0fe / 7ecbff / #FFB27E / 73c7ff / 7ecfe2 / 8ac8f1 -->
	<color name="suggestion_selected_text">#000</color>
	<color name="suggestion_separator">#888888</color>

	<color name="tutorial_background_color">#888</color>
	<color name="tutorial_button_background">#A1E483</color>
	<color name="tutorial_button_text_color">#000</color>
	<color name="tutorial_text_balloon_background">#fff</color>

	<!--*******************************************
		Settings screens (not the keyboard)
	*******************************************-->

	<color name="prefs_page_background">#f5f5f3</color>
	<color name="prefs_title_background">#e0e2df</color>
	<color name="prefs_title_text_color">#23262a</color>
	<color name="prefs_text_color">#1b1e22</color> <!-- row titles -->
	<color name="prefs_summary_text_color">#5d6167</color> <!-- summaries, section titles -->
	<color name="prefs_accent">#2f7d72</color> <!-- the one accent -->
	<color name="prefs_highlight">#262f7d72</color> <!-- the accent, at a strength that reads on the page -->
</resources>
