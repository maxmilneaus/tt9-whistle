# Built application files
*.apk
*.ap_

# Files for the Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/

# Gradle/build files
.gradle/
assets/
# The speech model is redistributed with this fork under Apache-2.0 (see
# THIRD-PARTY.md), so it stays tracked even though the other generated assets
# under app/src/main/assets do not.
!app/src/main/assets/
app/src/main/assets/*
!app/src/main/assets/whistle/
app/src/main/assets/whistle/*
!app/src/main/assets/whistle/whistle.cact
build/
app/full/
app/lite/
app/premium/
release/
app/src/full/assets/

# Local packaging outputs (private: signed APKs and module zips, never publish)
/dist/
# Staging tree make-module.sh writes (dist/module) and any hand-made copy of it
/dist/module/
/module/

# Local extraction and toolchain scratch: unpacked upstream APKs, pinned JDKs,
# Gradle distributions and anything else pulled in for a build
/work/
/extract/
/upstream/

# Packed output of any build step. The dictionary and ngram inputs that upstream
# ships in the repository under app/languages stay visible.
*.idsig
*.zip
!/app/languages/**

# Private dictation credentials: the OpenCode key staged for import. The real file
# lives outside this repository, at ~/.config/qin-dictation/opencode-go.key, and
# must never be added here.
opencode-go.key
*.key

# Premium code (it's in a different repo)
app/src/premium/

# Local configuration file (sdk path, etc)
local.properties

# Log Files
*.log

#Other
t9build.properties
*.keystore

# IDE project files
*.iws
*.iml
.idea/
proguard/
*.sublime-project
*.sublime-workspace
